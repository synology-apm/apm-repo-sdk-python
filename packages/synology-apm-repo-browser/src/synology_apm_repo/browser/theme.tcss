/* Shared styling for the Miller-column and folder-tree/file-table browse
   layouts, the breadcrumb/status bars, and the filter/goto inputs. */

Screen {
    layout: vertical;
}

#columns {
    layout: horizontal;
    height: 1fr;
}

/* scrollbar-gutter: stable reserves the scrollbar column permanently; when
   it appears and disappears with the row count, a terminal's diff-only
   repaint can leave a skewed border segment at the boundary. */
#columns DataTable,
#columns Tree {
    width: 1fr;
    height: 1fr;
    border: solid $panel;
    scrollbar-gutter: stable;
}

#columns DataTable:focus,
#columns Tree:focus {
    border: solid $accent;
}

/* UnitScreen's folder-tree/file-table split: the tree pane is narrower
   than its content pane. */
#browser {
    layout: horizontal;
    height: 3fr;
}

/* scrollbar-gutter: stable -- see #columns's identical rule above for why. */
#browser Tree {
    width: 30%;
    height: 1fr;
    border: solid $panel;
    scrollbar-gutter: stable;
}

#browser DataTable {
    width: 1fr;
    height: 1fr;
    border: solid $panel;
    scrollbar-gutter: stable;
}

#browser Tree:focus,
#browser DataTable:focus {
    border: solid $accent;
}

/* BrowseScreen's fixed one-line status, always visible. */
#open-status {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

/* UnitScreen's detail pane: #detail sizes to its full content height
   inside a VerticalScroll, so a long preview scrolls instead of clipping. */
#detail-scroll {
    width: 1fr;
    height: 1fr;
    border: solid $panel;
    padding: 0 1;
}

#detail-scroll:focus {
    border: solid $accent;
}

#detail {
    width: 100%;
    height: auto;
}

/* A SharePoint List overview (DetailOverview) is a pre-rendered table that
   must not wrap to the pane width. `DetailPane.render()` toggles this class
   only while one is showing: #detail sizes to the table's width (at least
   the pane's) and the scroll container pans horizontally. */
#detail-scroll.wide-preview {
    overflow-x: auto;
}

#detail.wide-preview {
    width: auto;
    min-width: 100%;
}

#breadcrumb {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}

#status-bar {
    height: 1;
    background: $panel-darken-1;
    color: $text-muted;
    padding: 0 1;
}

/* Filter box (`/`) and goto-ref box (`g`): hidden until their action adds
   "active", then docked to the bottom so nothing above reflows. */
#filter-input,
#goto-input {
    display: none;
}

#filter-input.active,
#goto-input.active {
    display: block;
    dock: bottom;
    height: 1;
}
